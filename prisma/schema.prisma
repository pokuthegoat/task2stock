// Persistence for the domain contract in src/lib/domain/model.ts.
// PortfolioView is computed — it is not a table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  /// bcrypt hash. Never send this field to the client.
  passwordHash String
  createdAt    DateTime @default(now())

  sessions AuthSession[]
  rewards  Reward[]
  holdings Holding[]
}

/// Opaque server session. Cookie stores only this id.
model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id        String @id
  name      String
  sortOrder Int    @default(0)
  tasks     Task[]
}

model Task {
  id          String  @id
  companyId   String
  title       String
  description String
  category    String
  difficulty  String
  estimate    String
  timeBucket  String
  featured    Boolean
  onHome      Boolean
  sortOrder   Int     @default(0)

  company       Company            @relation(fields: [companyId], references: [id])
  lines         TaskLine[]
  rewardOffer   RewardOffer?
  attempts      TaskAttempt[]
  completions   TaskCompletion[]
  submissions   ProofSubmission[]
  rewards       Reward[]
  sourceHoldings Holding[]
}

/// Copy attached to a task. Kind is requirement | step | instruction | eligibility.
model TaskLine {
  id        String @id
  taskId    String
  kind      String
  sortOrder Int
  body      String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, sortOrder])
}

/// What a task promises. 1:1 with Task. Not a granted Reward.
model RewardOffer {
  taskId      String @id
  amountCents Int
  ticker      String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttempt {
  id                 String    @id
  userId             String
  taskId             String
  /// in_progress | marked_complete
  status             String
  /// JSON number[] of checked step indexes
  checkedStepIndexes String
  startedAt          DateTime
  markedCompleteAt   DateTime?

  task       Task            @relation(fields: [taskId], references: [id])
  completion TaskCompletion?

  /// Authenticated User.id. Legacy unsigned participant rows are isolated and not linked.
  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model TaskCompletion {
  id               String   @id
  attemptId        String   @unique
  userId           String
  taskId           String
  markedCompleteAt DateTime

  attempt    TaskAttempt      @relation(fields: [attemptId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id])
  submission ProofSubmission?

  @@index([userId])
  @@index([taskId])
}

model ProofSubmission {
  id              String   @id
  completionId    String   @unique
  userId          String
  taskId          String
  details         String
  submittedAt     DateTime
  fileName        String?
  fileContentType String?
  fileSize        Int?
  fileStorageKey  String?

  completion   TaskCompletion       @relation(fields: [completionId], references: [id])
  task         Task                 @relation(fields: [taskId], references: [id])
  verification VerificationRecord?
  rewards      Reward[]

  @@index([userId])
  @@index([taskId])
}

/// Status only: none | submitted | verified. No reviewer, rejection, or method fields.
model VerificationRecord {
  submissionId String   @id
  status       String
  updatedAt    DateTime

  submission ProofSubmission @relation(fields: [submissionId], references: [id])
}

/// Operator-issued grant after proof is verified. Status: not_issued | issued.
/// Not a payment, payout, or Holding. Real-world delivery is outside the app.
model Reward {
  id           String  @id
  userId       String
  taskId       String
  submissionId String?
  amountCents  Int
  ticker       String
  status       String

  user       User             @relation(fields: [userId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id])
  submission ProofSubmission? @relation(fields: [submissionId], references: [id])

  @@index([userId])
  @@index([taskId])
}

/// A user's ownership position. Status: preview | not_settled.
model Holding {
  id           String  @id
  userId       String
  ticker       String
  name         String
  valueCents   Int
  sourceTaskId String?
  status       String

  user       User  @relation(fields: [userId], references: [id])
  sourceTask Task? @relation(fields: [sourceTaskId], references: [id])

  @@index([userId])
}
