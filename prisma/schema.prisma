// Persistence for the domain contract in src/lib/domain/model.ts.
// PortfolioView is computed — it is not a table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  /// Unique handle. Null until first-time profile setup.
  username      String?  @unique
  email         String?  @unique
  /// Google OIDC subject. Stable identity for Google sign-in. Null for email/password-only users.
  googleSub     String?  @unique
  /// Privy user DID. Stable identity for Login with Privy.
  privyDid      String?  @unique
  /// scrypt hash for email/password accounts. Null for Google-only users.
  passwordHash  String?
  avatarUrl     String?
  /// Unused by current auth. Kept to preserve existing rows.
  walletAddress String?  @unique
  /// Set when username is first saved and on each later username change.
  usernameChangedAt DateTime?
  /// Set only after a successful email change. Null means the first change is open.
  emailChangedAt    DateTime?
  /// Set only after a successful password change. Null means the first change is open.
  passwordChangedAt DateTime?
  createdAt     DateTime @default(now())

  sessions AuthSession[]
  rewards  Reward[]
  holdings Holding[]
}

/// Opaque server session. Cookie stores only this id.
model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id        String @id
  name      String
  sortOrder Int    @default(0)
  tasks     Task[]
}

model Task {
  id          String  @id
  companyId   String
  title       String
  description String
  category    String
  difficulty  String
  estimate    String
  timeBucket  String
  featured    Boolean
  onHome      Boolean
  sortOrder   Int     @default(0)

  company       Company            @relation(fields: [companyId], references: [id])
  lines         TaskLine[]
  rewardOffer   RewardOffer?
  attempts      TaskAttempt[]
  completions   TaskCompletion[]
  submissions   ProofSubmission[]
  rewards       Reward[]
  sourceHoldings Holding[]
}

/// Copy attached to a task. Kind is requirement | step | instruction | eligibility.
model TaskLine {
  id        String @id
  taskId    String
  kind      String
  sortOrder Int
  body      String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, sortOrder])
}

/// What a task promises. 1:1 with Task. Not a granted Reward.
model RewardOffer {
  taskId      String @id
  amountCents Int
  ticker      String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttempt {
  id                 String    @id
  userId             String
  taskId             String
  /// in_progress | marked_complete
  status             String
  /// JSON number[] of checked step indexes
  checkedStepIndexes String
  startedAt          DateTime
  markedCompleteAt   DateTime?

  task       Task            @relation(fields: [taskId], references: [id])
  completion TaskCompletion?

  /// Authenticated User.id. Legacy unsigned participant rows are isolated and not linked.
  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model TaskCompletion {
  id               String   @id
  attemptId        String   @unique
  userId           String
  taskId           String
  markedCompleteAt DateTime

  attempt    TaskAttempt      @relation(fields: [attemptId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id])
  submission ProofSubmission?

  @@index([userId])
  @@index([taskId])
}

model ProofSubmission {
  id              String   @id
  completionId    String   @unique
  userId          String
  taskId          String
  details         String
  submittedAt     DateTime
  fileName        String?
  fileContentType String?
  fileSize        Int?
  fileStorageKey  String?
  /// External https video URL. Never downloaded or stored in Blob.
  videoUrl        String?

  completion   TaskCompletion       @relation(fields: [completionId], references: [id])
  task         Task                 @relation(fields: [taskId], references: [id])
  verification VerificationRecord?
  rewards      Reward[]

  @@index([userId])
  @@index([taskId])
}

/// Status: none | submitted | verified | rejected.
/// rejectionReason is set only when status is rejected.
model VerificationRecord {
  submissionId     String   @id
  status           String
  rejectionReason  String?
  updatedAt        DateTime

  submission ProofSubmission @relation(fields: [submissionId], references: [id])
}

/// ETH payout claim after proof is verified.
/// Status: claim_requested | paid (legacy rows may still use issued = paid).
/// Catalog amountCents/ticker stay as task reference; ethAmount is the MVP payout.
model Reward {
  id                  String    @id
  userId              String
  taskId              String
  submissionId        String?   @unique
  amountCents         Int
  ticker              String
  /// Configured ETH amount for manual treasury payout, e.g. "0.01".
  ethAmount           String    @default("0.01")
  status              String
  /// Explicit EVM address the user provided for this claim. Not the Privy wallet.
  payoutWalletAddress String?
  claimedAt           DateTime?
  paidAt              DateTime?
  /// Optional tx hash recorded by admin after manual MetaMask send. Informational only.
  txHash              String?

  user       User             @relation(fields: [userId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id])
  submission ProofSubmission? @relation(fields: [submissionId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([status])
}

/// A user's ownership position. Status: preview | not_settled.
model Holding {
  id           String  @id
  userId       String
  ticker       String
  name         String
  valueCents   Int
  sourceTaskId String?
  status       String

  user       User  @relation(fields: [userId], references: [id])
  sourceTask Task? @relation(fields: [sourceTaskId], references: [id])

  @@index([userId])
}
