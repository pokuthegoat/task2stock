# Local SQLite. No cloud account or production credentials.
# Copy this file to `.env` before `npm run db:migrate`.
DATABASE_URL="file:./dev.db"

# Vercel cannot persist a SQLite file. Serverless filesystems are read-only
# except /tmp, and /tmp is not shared across requests.
# Create a Turso (libSQL) database, apply prisma/migrations there, then set:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Keep DATABASE_URL="file:./dev.db" so Prisma can resolve the schema datasource.

# Catalog reads use Prisma. Portfolio/holdings stay on fixtures.
DATA_SOURCE="database"

# Google OAuth. Client ID is used in the authorization redirect.
# Client secret is server-only — never prefix it with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public contact recipient for /contact mailto.
NEXT_PUBLIC_CONTACT_EMAIL=task2stock@gmail.com

# Proof file storage. Never store file bytes in SQLite.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/proofs

# Required only when STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Comma-separated User.id values allowed to verify proof and issue rewards.
# Empty means no signed-in user can do either. Not a production admin role.
# VERIFICATION_ADMIN_USER_IDS=
